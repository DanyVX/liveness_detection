# Copy to .env (gitignored). All variables are prefixed LIVENESS_.

# Root folder holding real datasets (never committed). See DATA.md for the layout.
LIVENESS_DATA_DIR=./data

# Global seed used by splits, training and tests.
LIVENESS_SEED=1337

# DEBUG | INFO | WARNING | ERROR
LIVENESS_LOG_LEVEL=INFO

# true -> one JSON object per log line
LIVENESS_LOG_JSON=false
